rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(giaPhaId, uid) {
      let giaPha = get(/databases/$(database)/documents/giaPha/$(giaPhaId)).data;
      return uid in giaPha.editors || uid == giaPha.ownerUid;
    }

    // What a join request may say about the person asking: bounded text fields.
    function validRequestDetails(d) {
      return d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 100
        && d.country is string && d.country.size() > 0 && d.country.size() <= 60
        && d.notes is string && d.notes.size() <= 1000;
    }

    match /giaPha/{giaPhaId} {
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.editors || request.auth.uid == resource.data.ownerUid);

      // Owner creates the tree with themselves as the sole initial editor.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.editors == [request.auth.uid];

      // Only existing members ever change the tree document — a non-member can never write
      // to it, so knowing the tree's id (it ships in the app) is not enough to get in.
      allow update: if request.auth != null && (
        (
          (request.auth.uid in resource.data.editors || request.auth.uid == resource.data.ownerUid)
          && (
            // Update tree metadata (e.g. renaming) without touching `editors`.
            request.resource.data.editors == resource.data.editors ||
            // Approve a join request: append exactly one uid to `editors` — and only one who has
            // asked, i.e. has a doc in `joinRequests`. Nothing else may change in the same write.
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editors'])
              && request.resource.data.editors.size() == resource.data.editors.size() + 1
              && request.resource.data.editors == resource.data.editors.concat(
                [request.resource.data.editors[request.resource.data.editors.size() - 1]])
              && exists(/databases/$(database)/documents/giaPha/$(giaPhaId)/joinRequests/$(
                request.resource.data.editors[request.resource.data.editors.size() - 1])))
          )
        ) ||
        // A relative whose phone-verified number a member has put on `allowedPhones` joins
        // themselves, no approval needed: they may append only their own uid, nothing else.
        (request.auth.token.phone_number != null
          && exists(/databases/$(database)/documents/giaPha/$(giaPhaId)/allowedPhones/$(request.auth.token.phone_number))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editors'])
          && request.resource.data.editors.size() == resource.data.editors.size() + 1
          && request.resource.data.editors == resource.data.editors.concat([request.auth.uid])) ||
        // Likewise for a relative whose Google-verified email a member has put on `allowedEmails`.
        (request.auth.token.email != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/giaPha/$(giaPhaId)/allowedEmails/$(request.auth.token.email.lower()))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editors'])
          && request.resource.data.editors.size() == resource.data.editors.size() + 1
          && request.resource.data.editors == resource.data.editors.concat([request.auth.uid]))
      );

      allow delete: if false;

      match /members/{memberId} {
        allow read: if request.auth != null && isMember(giaPhaId, request.auth.uid);

        allow create: if request.auth != null
          && isMember(giaPhaId, request.auth.uid)
          && request.resource.data.lastEditedBy == request.auth.uid;

        allow update: if request.auth != null && isMember(giaPhaId, request.auth.uid) && (
          // Normal field edits must be attributed to the editor making them.
          request.resource.data.lastEditedBy == request.auth.uid ||
          // Story additions/removals are additive per-contributor entries (see spec §9),
          // not a value being overwritten, so they don't require matching lastEditedBy.
          // NOTE: this only guarantees *some* current member modified `stories` — enforcing
          // "only the original contributor or the owner may delete a given entry" at the
          // rules level would need per-array-element diffing that Firestore rules can't do
          // cleanly. That check is enforced client-side only (accepted v1 gap; a full fix
          // would need Cloud Functions, which is out of scope per spec §16).
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stories'])
        );

        allow delete: if request.auth != null && isMember(giaPhaId, request.auth.uid);
      }

      // A signed-in person asking to be let in. They can only create/read their own request;
      // members read them all, decline (status -> declined) and delete them (approving deletes
      // the request as it adds the uid to `editors`).
      match /joinRequests/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isMember(giaPhaId, request.auth.uid));

        allow create: if request.auth != null
          && request.auth.uid == uid
          && !isMember(giaPhaId, uid)
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'contact', 'country', 'notes', 'status', 'requestedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.contact is string && request.resource.data.contact.size() <= 100
          && validRequestDetails(request.resource.data)
          && request.resource.data.status == 'pending';

        allow update: if request.auth != null && (
          // A member declines (or reopens) a request.
          (isMember(giaPhaId, request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['pending', 'declined']) ||
          // The requester corrects their details and asks again after being declined.
          (request.auth.uid == uid
            && resource.data.status == 'declined'
            && request.resource.data.status == 'pending'
            && validRequestDetails(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'requestedAt', 'displayName', 'country', 'notes']))
        );

        allow delete: if request.auth != null && isMember(giaPhaId, request.auth.uid);
      }

      // Phone numbers (E.164 doc ids) of known relatives who may join without approval.
      // Members manage the list; the rule on `giaPha` update checks it with exists().
      match /allowedPhones/{phone} {
        allow read, create, update, delete: if request.auth != null && isMember(giaPhaId, request.auth.uid);
      }

      // Google emails (lower-case doc ids) of known relatives who may join without approval.
      match /allowedEmails/{email} {
        allow read, create, update, delete: if request.auth != null && isMember(giaPhaId, request.auth.uid);
      }

      // Who has the tree open right now: one doc per member, holding only a heartbeat time.
      match /presence/{uid} {
        allow read: if request.auth != null && isMember(giaPhaId, request.auth.uid);
        allow write: if request.auth != null && request.auth.uid == uid && isMember(giaPhaId, request.auth.uid)
          && (request.method == 'delete' || request.resource.data.keys().hasOnly(['lastSeen']));
      }

      match /editorProfiles/{uid} {
        allow read: if request.auth != null && isMember(giaPhaId, request.auth.uid);
        allow write: if request.auth != null && request.auth.uid == uid && isMember(giaPhaId, request.auth.uid);
      }
    }

    // Narrow, denormalized doc (id = invite code) used for the public WhatsApp-preview
    // lookup in functions/join/[code].js — exposes only { giaPhaId, name }, never the
    // real giaPha document, and only via a direct doc-id get (never a query/list).
    match /inviteCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && isMember(request.resource.data.giaPhaId, request.auth.uid);
      // Kept in sync by any current member, mirroring giaPha's own rename permission
      // (renaming a tree updates both docs in the same client-side call).
      allow update: if request.auth != null
        && isMember(resource.data.giaPhaId, request.auth.uid)
        && request.resource.data.giaPhaId == resource.data.giaPhaId;
      allow delete: if false;
    }
  }
}
